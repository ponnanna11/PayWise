# PayWise Environment Configuration
# Copy this file to .env for local overrides if needed.

# Application Settings
PAYWISE_ENV=development
PAYWISE_DB_PATH=data/paywise_sim.db
PAYWISE_DEFAULT_CURRENCY=INR

# Google Gemini Runtime AI Integration
# Set your Gemini API key to enable live Gemini Flash High agent operations.
# If omitted or empty, PayWise operates in transparent DETERMINISTIC_FALLBACK mode.
GEMINI_API_KEY=
PAYWISE_AI_MODEL=gemini-2.5-flash
PAYWISE_AI_PROVIDER=gemini
